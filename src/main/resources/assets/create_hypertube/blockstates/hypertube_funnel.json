{
  "multipart": [
    { "when": { "facing": "north" },
      "apply": { "model": "create_hypertube:block/hypertube_funnel/funnel", "uvlock": false }
    },
    { "when": { "facing": "east" },
      "apply": { "model": "create_hypertube:block/hypertube_funnel/funnel", "y": 90, "uvlock": false }
    },
    { "when": { "facing": "south" },
      "apply": { "model": "create_hypertube:block/hypertube_funnel/funnel", "y": 180, "uvlock": false }
    },
    { "when": { "facing": "west" },
      "apply": { "model": "create_hypertube:block/hypertube_funnel/funnel", "y": 270, "uvlock": false }
    },
    { "when": { "facing": "up" },
      "apply": { "model": "create_hypertube:block/hypertube_funnel/funnel", "x": 270, "uvlock": false }
    },
    { "when": { "facing": "down" },
      "apply": { "model": "create_hypertube:block/hypertube_funnel/funnel", "x": 90, "uvlock": false }
    }
  ]
}
